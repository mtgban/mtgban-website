# Colly caches
.cache/

# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib
mtgban-website

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Dependency directories (remove the comment below to include it)
vendor/

# Scraper daily cache
cache_*

# Configuration files
*.json

# Offline-mode wire-format fixtures (exempt from the *.json ignore above)
!tests/offline/fixtures/*.json

# Logs directory
logs/

# Finder metadata
.DS_Store

#dev container stuff
compose-dev.yaml

# IntelliJ
.idea/

pg-data/

# Claude Workspaces
.claude

# Visual parity harness package manifest (exempt from the *.json ignore above)
!scripts/visual-diff/package.json
